# setup-database.sh creates .env with a generated password (permissions 0600).
# Never commit .env. Use one unquoted URL; URL-encode special password characters.
DATABASE_URL=postgresql://safety_app:CHANGE_ME@localhost:5432/safety_system

# Deteksi (OPSIONAL — semua kunci punya default, server jalan tanpa apa pun).
# Model dimuat otomatis dari models/best_v8_3class.pt (ikut repo) atau
# Hugging Face Akhnaf03/HARNES-YOLOv8 (public, auto-fetch bila lokal hilang).
# Pasang dulu requirements-ml.txt (termasuk huggingface_hub).
#
# DETECTION_MODEL_PATH = lokasi alternatif model .pt (default: models/best_v8_3class.pt di repo).
# DETECTION_CONF      = ambang confidence inference (default 0.40 — kalibrasi test v8).
# DETECTION_IMGSZ     = ukuran input model (default 1280 — dipakai training v8; jangan diturunkan).
#
# DETECTION_CLASSES = FILTER KELAS DI INFERENCE (default 0,2).
#   Model v8 punya 3 kelas: 0=excavator, 1=excavator_arm, 2=person.
#   Hanya ID yang terdaftar yang diteruskan ke zona/alert; kelas lain tetap
#   dihitung model tapi disembunyikan dari pipeline (tanpa efek ke kelas lain —
#   NMS per kelas; tidak perlu retrain).
#   Mengapa default 0,2: zona piksel MVP memakai bounding box EXCAVATOR sebagai
#   jangkar; box arm justru mengacaukan jangkar zona. Kelas arm disimpan untuk
#   nanti: saat zona ayun berbasis jangkauan lengan dibangun, set 0,1,2.
#
# DETECTION_MODEL_PATH=/path/ke/model_lain.pt
# DETECTION_CONF=0.40
# DETECTION_IMGSZ=1280
# DETECTION_CLASSES=0,2
# HF_MODEL_REPO=Akhnaf03/HARNES-YOLOv8
# HF_MODEL_FILENAME=best_v8_3class.pt

# Zona meter (OPSIONAL — default 4 m; hanya berlaku saat --calib diberikan).
# ZONE_RADIUS_M=4

# Evidence burst (OPSIONAL — default tempdir di luar repo).
# EVIDENCE_DIR=/path/ke/evidence

# Push APNs (M7, OPSIONAL — default mock tanpa koneksi Apple).
# APNS_MODE=mock
# APNS_KEY_PATH=/path/AuthKey_XXXX.p8   # WAJIB di luar repo — jangan commit
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=YYYYYYYYYY
# APNS_BUNDLE_ID=com.anything.harnes
# APNS_ENVIRONMENT=development

# Endpoint HSE POST /test/alert untuk uji perangkat fisik; default mati.
# ENABLE_TEST_ALERTS=1
